# Database (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/finwise_ai
# Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/finwise_ai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/finwise_ai

# Security & Authentication (Generate a strong random 32+ character key for production)
JWT_SECRET=your-random-32-character-secret-key-for-jwt-signing
JWT_EXPIRATION_HOURS=72

# Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# CORS Allowed Origins (* for all, or comma-separated list like https://your-frontend.vercel.app)
CORS_ORIGINS=*

# Optional external AI services (if applicable)
AI_API_KEY=
